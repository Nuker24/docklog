# PostgreSQL connection string
# Local Docker Compose (see docker-compose.yml):
DATABASE_URL="postgresql://docklog:docklog@localhost:5432/docklog?schema=public"
# Or managed Postgres (Neon / Supabase / Vercel Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/docklog?sslmode=require"

# Auth.js (NextAuth v5) — required in production
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Show local demo username/password hints on /signin (never enable on hosted)
# DEMO_LOGIN_HINTS="true"
