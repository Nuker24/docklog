// DockLog Phase 2 — ops depth (par, FEFO picks, receive variance, cycle count)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LOGISTICS_ADMIN
  LOGISTICS_OPERATOR
  CLINIC_SUPPLY_USER
  AUDITOR
}

enum TempZone {
  AMBIENT
  REFRIGERATED
  FROZEN
  CONTROLLED_ROOM
}

enum CommodityClass {
  EXPENDABLE_MEDICAL_SUPPLY
  PHARMACY
}

enum LocationKind {
  WAREHOUSE
  CLINIC
}

enum RequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

/// Who fulfills the request: logistics warehouse vs Pharmacy SOS (C2C drugs).
enum RequestChannel {
  LOGISTICS
  PHARMACY_SOS
}

enum TransferStatus {
  ISSUED
  CONFIRMED
  CANCELLED
}

enum TransferKind {
  REQUEST_FULFILLMENT
  LOGISTICS_PUSH
  PHARMACY_C2C
  CLINIC_TRANSFER
}

enum InboundStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Hospital {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  warehouse         Warehouse?
  clinics           Clinic[]
  items             Item[]
  lots              Lot[]
  inventoryBalances InventoryBalance[]
  auditEvents       AuditEvent[]
  supplyRequests    SupplyRequest[]
  transfers         Transfer[]
  clinicParLevels   ClinicParLevel[]
  inboundShipments  InboundShipment[]
}

model User {
  id           String   @id @default(cuid())
  hospitalId   String
  username     String   @unique
  passwordHash String
  displayName  String
  role         UserRole
  clinicId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital          Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinic            Clinic?         @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  audits            AuditEvent[]
  requestsCreated   SupplyRequest[] @relation("RequestCreator")
  transfersIssued    Transfer[]       @relation("TransferIssuer")
  transfersConfirmed Transfer[]       @relation("TransferConfirmer")
  inboundShipments   InboundShipment[] @relation("InboundCreator")

  @@index([hospitalId])
  @@index([clinicId])
}

/// One warehouse per hospital.
model Warehouse {
  id         String   @id @default(cuid())
  hospitalId String   @unique
  code       String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital  Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([hospitalId, code])
}

model Clinic {
  id                   String   @id @default(cuid())
  hospitalId           String
  code                 String
  name                 String
  /// When true, logistics may push/issue expendable supply without a clinic request.
  logisticsPushEnabled Boolean  @default(false)
  /// Pharmacy clinic is source of supply (SOS) for drugs (C2C).
  isPharmacySos        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hospital         Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  users            User[]
  locations        Location[]
  supplyRequests   SupplyRequest[] @relation("RequestingClinic")
  inboundTransfers Transfer[]      @relation("TransferToClinic")
  outboundTransfers Transfer[]     @relation("TransferFromClinic")
  parLevels        ClinicParLevel[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model Location {
  id          String       @id @default(cuid())
  hospitalId  String
  warehouseId String?
  clinicId    String?
  code        String
  name        String
  kind        LocationKind
  tempZone    TempZone     @default(AMBIENT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  clinic            Clinic?            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  inventoryBalances InventoryBalance[]
  transferLinesFrom TransferLine[]
  transfersConfirmed Transfer[]        @relation("TransferConfirmLocation")

  @@unique([hospitalId, code])
  @@index([warehouseId])
  @@index([clinicId])
}

model Item {
  id             String         @id @default(cuid())
  hospitalId     String
  sku            String
  name           String
  description    String?
  uom            String         @default("EA")
  ndc            String?
  upc            String?
  commodityClass CommodityClass
  requiresCold   Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  lots              Lot[]
  inventoryBalances InventoryBalance[]
  requestLines       SupplyRequestLine[]
  transferLines      TransferLine[]
  clinicParLevels    ClinicParLevel[]
  inboundShipmentLines InboundShipmentLine[]

  @@unique([hospitalId, sku])
  @@index([hospitalId])
  @@index([ndc])
}

/// Target on-hand at a clinic for an item (expendable replenishment).
model ClinicParLevel {
  id         String   @id @default(cuid())
  hospitalId String
  clinicId   String
  itemId     String
  parQty     Decimal  @db.Decimal(14, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([clinicId, itemId])
  @@index([hospitalId])
  @@index([clinicId])
}

model Lot {
  id         String    @id @default(cuid())
  hospitalId String
  itemId     String
  lotNumber  String
  expiresOn  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item              Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryBalances InventoryBalance[]
  transferLines     TransferLine[]

  @@unique([itemId, lotNumber])
  @@index([hospitalId])
}

/// Inventory truth: (hospital, location, item, lot).
model InventoryBalance {
  id         String   @id @default(cuid())
  hospitalId String
  locationId String
  itemId     String
  lotId      String
  quantity   Decimal  @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lot      Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, locationId, itemId, lotId])
  @@index([hospitalId, locationId])
  @@index([itemId])
}

model SupplyRequest {
  id                  String         @id @default(cuid())
  hospitalId          String
  requestingClinicId  String
  channel             RequestChannel
  status              RequestStatus  @default(OPEN)
  notes               String?
  requestedById       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  hospital         Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  requestingClinic Clinic              @relation("RequestingClinic", fields: [requestingClinicId], references: [id], onDelete: Cascade)
  requestedBy      User?               @relation("RequestCreator", fields: [requestedById], references: [id], onDelete: SetNull)
  lines            SupplyRequestLine[]
  transfers        Transfer[]

  @@index([hospitalId, status])
  @@index([requestingClinicId])
  @@index([channel, status])
}

model SupplyRequestLine {
  id                 String  @id @default(cuid())
  requestId          String
  itemId             String
  quantityRequested  Decimal @db.Decimal(14, 3)
  quantityFulfilled  Decimal @default(0) @db.Decimal(14, 3)

  request SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([itemId])
}

/// Issue/transfer to a clinic. Stock leaves source on ISSUED; clinic on-hand updates on CONFIRMED.
model Transfer {
  id              String         @id @default(cuid())
  hospitalId      String
  kind            TransferKind
  status          TransferStatus @default(ISSUED)
  requestId       String?
  fromClinicId    String?
  toClinicId      String
  toLocationId    String?
  issuedById      String?
  confirmedById   String?
  issuedAt        DateTime       @default(now())
  confirmedAt     DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hospital    Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  request     SupplyRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  fromClinic  Clinic?        @relation("TransferFromClinic", fields: [fromClinicId], references: [id], onDelete: SetNull)
  toClinic    Clinic         @relation("TransferToClinic", fields: [toClinicId], references: [id], onDelete: Cascade)
  toLocation  Location?      @relation("TransferConfirmLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  issuedBy    User?          @relation("TransferIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  confirmedBy User?          @relation("TransferConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  lines       TransferLine[]

  @@index([hospitalId, status])
  @@index([toClinicId, status])
  @@index([fromClinicId, status])
  @@index([requestId])
}

/// Lightweight PO/ASN header for assisted receiving (no EDI).
model InboundShipment {
  id              String        @id @default(cuid())
  hospitalId      String
  referenceNumber String
  vendorName      String?
  status          InboundStatus @default(OPEN)
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital  Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("InboundCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     InboundShipmentLine[]

  @@unique([hospitalId, referenceNumber])
  @@index([hospitalId, status])
}

model InboundShipmentLine {
  id               String  @id @default(cuid())
  shipmentId       String
  itemId           String
  quantityExpected Decimal @db.Decimal(14, 3)
  quantityReceived Decimal @default(0) @db.Decimal(14, 3)

  shipment InboundShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  item     Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([itemId])
}

model TransferLine {
  id             String  @id @default(cuid())
  transferId     String
  itemId         String
  lotId          String
  fromLocationId String
  quantity       Decimal @db.Decimal(14, 3)

  transfer     Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot          Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  fromLocation Location @relation(fields: [fromLocationId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([itemId])
}

/// Append-only audit for receive / issue / confirm / request.
model AuditEvent {
  id         String   @id @default(cuid())
  hospitalId String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
  @@index([entityType, entityId])
}
